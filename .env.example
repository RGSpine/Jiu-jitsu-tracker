# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do app. Em produção, a URL da Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leitura de texto. Sem DEEPSEEK_API_KEY o formulário manual continua
# e a opção Texto explica que a chave não está configurada.
# Modelo verificado em https://api-docs.deepseek.com/ : deepseek-flash
# (DeepSeek-V4.1-Flash-1017). deepseek-v4-flash é nome antigo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Transcrição de áudio. A DeepSeek não tem speech-to-text.
# Padrão: Groq whisper-large-v3, com language=pt e dica do glossário.
# STT_MODEL troca o modelo. Sem STT_MODEL:
#   groq  -> whisper-large-v3
#   openai -> gpt-transcribe
# (whisper-1 e gpt-4o-transcribe saem da API da OpenAI em 2027-02-26.)
STT_PROVIDER=groq
STT_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=

# App nativo (ainda não publicado). Ver docs/MOBILE.md.
# CAPACITOR_SERVER_URL é a URL da Vercel que o WebView abre.
# CAPACITOR_ORIGINS libera CORS nas rotas /api quando a casca não é o próprio site.
CAPACITOR_APP_ID=com.rgspine.tatame
CAPACITOR_SERVER_URL=
CAPACITOR_ORIGINS=
