# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do app. Em produção, a URL da Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leitura de texto. Sem DEEPSEEK_API_KEY o formulário manual continua
# e a opção Texto explica que a chave não está configurada.
# Modelo verificado em https://api-docs.deepseek.com/ : deepseek-flash
# (DeepSeek-V4.1-Flash-1017). deepseek-v4-flash é nome antigo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Transcrição de áudio. A DeepSeek não tem speech-to-text.
# STT_PROVIDER=openai usa OPENAI_API_KEY.
# STT_PROVIDER=groq usa GROQ_API_KEY.
STT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
